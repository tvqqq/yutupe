# Create separate OAuth clients:
# - Chrome: OAuth client of type "Chrome Extension"
# - Edge & Firefox: OAuth client of type "Web application" with authorized redirect URI
WXT_GOOGLE_CLIENT_ID_CHROME=
WXT_GOOGLE_CLIENT_ID_EDGE=
WXT_GOOGLE_CLIENT_ID_FIREFOX=

# Public keys keep unpacked/build IDs stable on Chromium. Never commit private keys.
WXT_EXTENSION_KEY_CHROME=
WXT_EXTENSION_KEY_EDGE=

# Firefox Extension ID (gecko.id in manifest.json browser_specific_settings)
WXT_EXTENSION_ID_FIREFOX=youtube-collections@extension.local
